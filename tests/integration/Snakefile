# Emulate a user configuring the module.
configfile: workflow.source_path("./test_config.yaml")


rule create_external_shapes:
    output:
        "resources/user/test/shapes.parquet",
    log:
        "logs/create_external_shapes.log",
    conda:
        "../../workflow/envs/module.yaml"
    params:
        url="https://zenodo.org/records/20765043/files/EUROPE_S_C1_ADM1.parquet?download=1",
    message:
        "Emulating shape inputs for integration testing."
    shell:
        "curl --fail --silent --show-error --location --output {output:q} {params.url:q} 2> {log:q}"


# Import the module and configure it.
module module_euro_building_heat:
    pathvars:
        # Redirect specific user resources (inputs)
        shapes=rules.create_external_shapes.output[0],
        edh_api="resources/user/edh_api.txt",
        # Redirect specific module results (outputs)
        heat_demand="results/output/{shapes}/hourly/heat_demand_mwh.parquet",
        heat_pump_cop="results/output/{shapes}/hourly/heat_pump_cop_pu.parquet",
        # Redirect intermediate files that are internal to the module
        logs="resources/module/logs",
        resources="resources/module/resources",
        results="resources/module/results",
    snakefile:
        "../../workflow/Snakefile"
    config:
        config["module_euro_building_heat"]


# Rename all module rules with a prefix, to avoid naming conflicts.
use rule * from module_euro_building_heat as module_euro_building_heat_*


# Request something from the module.
rule all:
    default_target: True
    input:
        "results/output/test/hourly/heat_demand_mwh.parquet",
        "results/output/test/hourly/heat_pump_cop_pu.parquet",
    message:
        "A generic dry-run test case for the heat demand module."
