rule all_scenario_outputs:
    input:
        building_count=rules.merge_building_count.output.building_count,
        building_figures=[
            rules.merge_building_count.output.building_count_plot,
            rules.merge_structural_support.output.residential_space_heat_weight_plot,
            rules.merge_structural_support.output.commercial_space_heat_weight_plot,
        ],
        scenario_outputs=lambda wc: expand(
            [
                rules.rescale_annual_heat_demand_to_shapes.output.annual_demand,
                rules.rescale_annual_heat_demand_to_shapes.output.space_heat,
                rules.rescale_annual_heat_demand_to_shapes.output.hot_water,
                rules.heat_demand_final_timeseries.output.timeseries,
                rules.heat_demand_final_timeseries.output.space_heat_profile,
                rules.heat_demand_final_timeseries.output.hot_water_profile,
                rules.heat_pump_electricity_demand_timeseries.output.cop,
                rules.heat_pump_electricity_demand_timeseries.output.electricity_demand,
                rules.district_heating_areas.output.areas,
                rules.rescale_annual_heat_demand_to_shapes.output.density,
                rules.rescale_annual_heat_demand_to_shapes.output.choropleth,
                rules.heat_demand_final_timeseries.output.plot,
                rules.heat_pump_electricity_demand_timeseries.output.cop_plot,
                rules.heat_pump_electricity_demand_timeseries.output.electricity_demand_plot,
            ],
            shapes=wc.shapes,
            scenario=wc.scenario,
            year=config["scenarios"][wc.scenario]["heat_demand"],
        ),
    output:
        touch("<results>/{shapes}/{scenario}/all_outputs"),
