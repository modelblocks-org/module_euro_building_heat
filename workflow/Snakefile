import yaml

from snakemake.utils import min_version, validate

min_version("9.19")


# !!!!! IMPORTANT !!!!!
# Define pathvars for all user resource files and result files
# This allows users to re-wire how the module is used in their workflow with ease.
pathvars:
    # User resources
    shapes="<resources>/user/{shapes}/shapes.parquet",
    # Module results
    annual_heat_demand="<results>/{shapes}/annual/heat_demand_twh.parquet",
    heat_demand="<results>/{shapes}/aggregated/heat_demand.parquet",
    heat_demand_visualization="<results>/{shapes}/visualization/heat_demand.html",


# Load the example configuration. This will be overridden by users.
configfile: workflow.source_path("../config/config.yaml")


# Validate the configuration using the schema file.
validate(config, workflow.source_path("internal/config.schema.yaml"))

# Load internal settings separately so users cannot modify them.
with open(workflow.source_path("internal/settings.yaml"), "r") as f:
    internal = yaml.safe_load(f)

config.setdefault("population", {})
config["population"].setdefault("resolution", 100)

if config["years"]["start"] >= config["years"]["end"]:
    raise ValueError(
        "Configuration error: years.start must be less than years.end. "
        "The end year is exclusive."
    )
if config["weather"]["start"] >= config["weather"]["end"]:
    raise ValueError(
        "Configuration error: weather.start must be less than weather.end. "
        "The end year is exclusive."
    )

MODEL_YEARS = list(range(config["years"]["start"], config["years"]["end"]))
WEATHER_YEARS = list(range(config["weather"]["start"], config["weather"]["end"]))
if len(MODEL_YEARS) != len(WEATHER_YEARS):
    raise ValueError(
        "Configuration error: weather year span must match model year span. "
        f"Got model years {MODEL_YEARS} and weather years {WEATHER_YEARS}."
    )
WEATHER_MODEL_YEARS = dict(zip(WEATHER_YEARS, MODEL_YEARS))

population_epoch = min(
    internal["resources"]["automatic"]["population_epochs"],
    key=lambda year: abs(year - config["years"]["start"]),
)
population_resolution = config["population"]["resolution"]
ghsl_population = {
    "epoch": population_epoch,
    "resolution": population_resolution,
    "stem": f"GHS_POP_E{population_epoch}_GLOBE_R2023A_54009_{population_resolution}",
}


# Add all your includes here.
include: "rules/automatic.smk"
include: "rules/annual_heat_demand.smk"
include: "rules/heat_timeseries.smk"


# Add additional files to be delivered alongside the workflow here.
# This is needed e.g. for python code files that are never
# explicitly used as a script or input in a snakemake rule.
# e.g.: workflow.source_path("scripts/_utils.py")


rule all:
    default_target: True
    output:
        "INVALID",
    log:
        stderr="<logs>/all.stderr",
    message:
        "ERROR: Invalid `rule all:` call"
    shell:
        'echo "This workflow must be called as a snakemake module." > {log.stderr}'
