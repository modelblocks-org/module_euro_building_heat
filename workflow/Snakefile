    heat_pump_cop="<results>/{shapes}/hourly/heat_pump_cop_pu.parquet",
    heat_pump_electricity_demand="<results>/{shapes}/hourly/heat_pump_electricity_demand_mwh.parquet",


# Explicitly merge defaults: Snakemake skips a module's configfile directive
# when its consumer supplies a config dictionary.
with open(workflow.source_path("../config/config.yaml")) as stream:
    defaults = yaml.safe_load(stream)
update_config(defaults, config)
config.clear()
config.update(defaults)


# Validate the configuration using the schema file.
validate(config, workflow.source_path("internal/config.schema.yaml"))

# Load internal settings separately so users cannot modify them.
with open(workflow.source_path("internal/settings.yaml"), "r") as f:
    internal = yaml.safe_load(f)


wildcard_constraints:
    ghsl_epoch="|".join(str(i) for i in internal["resources"]["ghsl"]["epochs"]),


# Add all your includes here.
