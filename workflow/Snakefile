import yaml

from snakemake.utils import min_version, update_config, validate

min_version("9.19")


# !!!!! IMPORTANT !!!!!
# Define pathvars for all user resource files and result files
# This allows users to re-wire how the module is used in their workflow with ease.
pathvars:
    # User resources
    shapes="<resources>/user/{shapes}/shapes.parquet",
    edh_api="<resources>/user/edh_api.txt",
    # Persistent building caches can be shared with other workflows.
    eubucco_cache="<resources>/automatic/eubucco",
    microsoft_cache="<resources>/automatic/microsoft",
    # Module results
    building_count="<results>/{shapes}/rasters/building_count.tif",
    annual_heat_demand="<results>/{shapes}/annual/heat_demand_twh.parquet",
    heat_demand="<results>/{shapes}/hourly/heat_demand_mwh.parquet",
    space_heat_demand="<results>/{shapes}/annual/space_heat_demand_mwh.tif",
    hot_water_demand="<results>/{shapes}/annual/hot_water_demand_mwh.tif",
    space_heat_profile="<results>/{shapes}/hourly/space_heat_profile.parquet",
